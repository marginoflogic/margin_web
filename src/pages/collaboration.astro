---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";

const email = "MarginOfLogic@protonmail.com";
const web3formsKey = "71b2cd72-5c28-4670-8e08-ac201aaf5fff";
---

<Layout title="Collaboration | Margin of Logic">
  <Header />
  <Main
    pageTitle="Collaboration"
    pageDesc="Analytical research access, consultations, and partnership inquiries."
  >
    <div class="space-y-10">
      <section class="space-y-6">
        <h2 class="text-sm font-semibold">Analytical Services</h2>

        <!-- Row 1: Primary Level Plans -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <!-- Product 1: Single Active Level -->
          <div class="border-border flex flex-col justify-between rounded-lg border p-5">
            <div class="space-y-4">
              <div>
                <p class="text-accent text-xs font-semibold tracking-wider uppercase">
                  One-Time // Single Level
                </p>
                <h3 class="mt-1 text-lg font-semibold">
                  Single Active Level (SAL)
                </h3>
              </div>

              <p class="text-sm leading-relaxed opacity-80">
                A single, standalone institutional price level identified
                through volume and liquidity mechanics, delivered without an
                ongoing subscription.
              </p>

              <div class="border-border border-y py-3">
                <p class="text-2xl font-bold">
                  €100 <span class="text-xs font-normal opacity-75">/ one-time</span>
                </p>
                <p class="mt-1 text-xs opacity-65">
                  or Cryptocurrency (EUR equivalent)
                </p>
              </div>

              <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed opacity-85">
                <li>
                  <strong class="font-semibold">Level Delivery (upon formation / within 24 hours):</strong>{" "}
                  Upon payment confirmation, you receive one non-public price
                  level as soon as a valid setup forms (or within 24 hours if a
                  valid level is already open), delivered as a separate email
                  containing:
                  <ul class="mt-1.5 list-['–_'] space-y-1 pl-4 text-xs opacity-90">
                    <li>Instrument / Pair</li>
                    <li>Direction</li>
                    <li>Active Level (Entry Ref.)</li>
                    <li>Invalidation (SL Ref.)</li>
                    <li>Target Zone (TP Ref.)</li>
                    <li>Risk-to-Reward (RRR)</li>
                    <li>Expected Horizon</li>
                    <li>Issued / Distance</li>
                    <li>Liquidity &amp; Volume Context</li>
                    <li>Chart Snapshot</li>
                  </ul>
                </li>
                <li>
                  <strong class="font-semibold">Price Proximity Alert:</strong>{" "}
                  Email notification when the market approaches within 50–70
                  pips of the active level.
                </li>
                <li>
                  <strong class="font-semibold">Pre-Entry Invalidation &amp; Automatic Replacement:</strong>{" "}
                  If the level is invalidated prior to entry due to changes in
                  market structure, a replacement level is issued automatically
                  at no additional cost.
                </li>
                <li>
                  <strong class="font-semibold">Service Completion:</strong>{" "}
                  The service concludes once the Target Zone (TP Ref.) or
                  Invalidation (SL Ref.) is reached. Client-initiated early
                  exits or manual adjustments do not alter service completion.
                </li>
                <li class="opacity-75">
                  <strong class="font-semibold">Active Level Management &amp; Risk Support (Excluded / Recommended Add-On):</strong>{" "}
                  Not included in base delivery. Recommended for continuous
                  volume-flow monitoring, early-exit context, and real-time risk
                  adjustments throughout the level's lifecycle.
                </li>
              </ul>
            </div>

            <div class="mt-6 pt-4">
              <button
                type="button"
                data-order-trigger="SAL"
                class="border-accent text-accent hover:bg-accent hover:text-background w-full cursor-pointer rounded border px-4 py-2 text-center text-sm font-semibold transition-colors"
              >
                Order
              </button>
            </div>
          </div>

          <!-- Product 2: Continuous 30-Pair Coverage -->
          <div class="border-border flex flex-col justify-between rounded-lg border p-5">
            <div class="space-y-4">
              <div>
                <p class="text-accent text-xs font-semibold tracking-wider uppercase">
                  Fixed Term // 30 FX Pairs
                </p>
                <h3 class="mt-1 text-lg font-semibold">
                  Continuous 30-Pair Coverage (30PC)
                </h3>
              </div>

              <p class="text-sm leading-relaxed opacity-80">
                Ongoing structural market coverage across 30 monitored currency
                pairs, driven strictly by institutional volume and liquidity
                mechanics.
              </p>

              <div class="border-border border-y py-3">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span>
                    <strong class="text-2xl font-bold">€250</strong>{" "}
                    <span class="text-xs font-normal opacity-75">/ 3 months</span>
                  </span>
                  <span class="opacity-40">·</span>
                  <span>
                    <strong class="text-2xl font-bold">€450</strong>{" "}
                    <span class="text-xs font-normal opacity-75">/ 6 months</span>
                  </span>
                  <span class="opacity-40">·</span>
                  <span>
                    <strong class="text-2xl font-bold">€650</strong>{" "}
                    <span class="text-xs font-normal opacity-75">/ 12 months</span>
                  </span>
                </div>
                <p class="mt-1 text-xs opacity-65">
                  or Cryptocurrency (EUR equivalent)
                </p>
              </div>

              <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed opacity-85">
                <li>
                  <strong class="font-semibold">Initial Load (within 24 hours):</strong>{" "}
                  Upon payment confirmation, you receive a summary of all
                  currently valid, non-public price levels across the 30
                  monitored pairs. The number of levels depends strictly on
                  current market conditions and volume—no fixed count is
                  guaranteed.
                </li>
                <li>
                  <strong class="font-semibold">Individual Level Delivery:</strong>{" "}
                  Throughout your coverage period, every newly formed,
                  non-public price level is delivered immediately as a separate
                  email containing:
                  <ul class="mt-1.5 list-['–_'] space-y-1 pl-4 text-xs opacity-90">
                    <li>Instrument / Pair</li>
                    <li>Direction</li>
                    <li>Active Level (Entry Ref.)</li>
                    <li>Invalidation (SL Ref.)</li>
                    <li>Target Zone (TP Ref.)</li>
                    <li>Risk-to-Reward (RRR)</li>
                    <li>Expected Horizon</li>
                    <li>Issued / Distance</li>
                    <li>Liquidity &amp; Volume Context</li>
                    <li>Chart Snapshot</li>
                  </ul>
                </li>
                <li>
                  <strong class="font-semibold">Price Proximity Alerts:</strong>{" "}
                  Email notification when the market approaches within 50–70
                  pips of any active level.
                </li>
                <li>
                  <strong class="font-semibold">Pre-Entry Invalidation Notices:</strong>{" "}
                  Immediate email notification if a level is invalidated prior
                  to entry due to changes in market structure.
                </li>
                <li>
                  <strong class="font-semibold">Expiration Notice:</strong>{" "}
                  Automated reminder 7 days before the end of your fixed term.
                </li>
                <li class="opacity-75">
                  <strong class="font-semibold">Active Level Management &amp; Risk Support (Excluded / Recommended Add-On):</strong>{" "}
                  Not included in base coverage. Recommended for continuous
                  volume-flow monitoring, early-exit context, and real-time risk
                  adjustments throughout each level's lifecycle.
                </li>
              </ul>
            </div>

            <div class="mt-6 pt-4">
              <button
                type="button"
                data-order-trigger="30PC"
                class="border-accent text-accent hover:bg-accent hover:text-background w-full cursor-pointer rounded border px-4 py-2 text-center text-sm font-semibold transition-colors"
              >
                Order
              </button>
            </div>
          </div>
        </div>

        <!-- Row 2: Add-on Support & Monthly Consultation -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <!-- Optional Add-on: Active Level Management -->
          <div class="border-accent/50 flex flex-col justify-between rounded-lg border p-5">
            <div class="space-y-4">
              <div>
                <p class="text-accent text-xs font-semibold tracking-wider uppercase">
                  Optional Add-On // For SAL &amp; 30PC
                </p>
                <h3 class="mt-1 text-lg font-semibold">
                  Active Level Management &amp; Risk Support (ALM)
                </h3>
              </div>

              <p class="text-sm leading-relaxed opacity-80">
                Event-driven analytical risk support covering your active base
                service, focused on order-flow shifts and structural protection.
              </p>

              <div class="border-border border-y py-3">
                <p class="text-2xl font-bold">
                  +€50{" "}
                  <span class="text-xs font-normal opacity-75">
                    / one-time add-on (applies to SAL or full 30PC term)
                  </span>
                </p>
                <p class="mt-1 text-xs opacity-65">
                  or Cryptocurrency (EUR equivalent)
                </p>
              </div>

              <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed opacity-85">
                <li>
                  <strong class="font-semibold">Scope &amp; Activation:</strong>{" "}
                  Available as a standalone add-on to either Single Active Level
                  (SAL) or Continuous 30-Pair Coverage (30PC). Covers the base
                  product as a whole (the active SAL level or all active levels
                  within your 30PC fixed term), regardless of level count. Can
                  be ordered at any time; activates upon payment confirmation.
                </li>
                <li>
                  <strong class="font-semibold">Event-Driven Updates:</strong>{" "}
                  Immediate email notifications are distributed strictly when a
                  structural or volume-flow shift occurs that may negatively
                  affect an open position (such as risk reduction, SL
                  adjustments, or early-exit context). Routine status updates
                  without structural changes are not included in this service.
                </li>
                <li>
                  <strong class="font-semibold">Communication Format:</strong>{" "}
                  Analytical updates delivered via no-reply email. For active
                  consultation across various trading topics, we recommend
                  purchasing Monthly Trading Consultation (MC).
                </li>
                <li>
                  <strong class="font-semibold">Service Completion &amp; Continuity:</strong>{" "}
                  Concludes automatically upon reaching the Target Zone (TP
                  Ref.), Invalidation (SL Ref.), structural early-exit (for
                  SAL), or expiration of the underlying 30PC fixed term.
                  Client-initiated early exits or manual adjustments do not
                  alter service completion. If a SAL level is invalidated prior
                  to entry, ALM transfers automatically to the replacement
                  level.
                </li>
              </ul>

              <p class="border-border border-t pt-4 text-xs leading-relaxed italic opacity-75">
                Based on published historical statistics, active volume-based risk
                management has improved outcome consistency by up to 30% compared
                to passive level holding.
              </p>
            </div>

            <div class="mt-6 pt-4">
              <button
                type="button"
                data-order-trigger="ALM"
                class="border-accent text-accent hover:bg-accent hover:text-background w-full cursor-pointer rounded border px-4 py-2 text-center text-sm font-semibold transition-colors"
              >
                Order
              </button>
            </div>
          </div>

          <!-- Product 3: Monthly Trading Consultation -->
          <div class="border-border flex flex-col justify-between rounded-lg border p-5">
            <div class="space-y-4">
              <div>
                <p class="text-accent text-xs font-semibold tracking-wider uppercase">
                  30 Days // Interactive Email
                </p>
                <h3 class="mt-1 text-lg font-semibold">
                  Monthly Trading Consultation (MC)
                </h3>
              </div>

              <p class="text-sm leading-relaxed opacity-80">
                Interactive email communication focused on market mechanics,
                volume and order-flow, risk management, and position reviews.
              </p>

              <div class="border-border border-y py-3">
                <p class="text-2xl font-bold">
                  €30 <span class="text-xs font-normal opacity-75">/ 30 days</span>
                </p>
                <p class="mt-1 text-xs opacity-65">
                  or Cryptocurrency (EUR equivalent)
                </p>
              </div>

              <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed opacity-85">
                <li>
                  <strong class="font-semibold">Format &amp; Response Time:</strong>{" "}
                  Interactive email communication, active from payment
                  confirmation until expiration. No fixed limit on the number of
                  emails or topics; guaranteed response within 24 hours.
                </li>
                <li>
                  <strong class="font-semibold">Scope &amp; Exclusions:</strong>{" "}
                  Covers market mechanics, volume and order-flow, risk
                  management, and reviews of client positions. Level-specific
                  consultations apply exclusively to levels issued by Margin of
                  Logic—analysis of client-created or third-party levels is not
                  included. This service does not include the delivery of new
                  entry levels beyond active SAL or 30PC services.
                </li>
                <li>
                  <strong class="font-semibold">Term &amp; Expiration:</strong>{" "}
                  Fixed 30-day term without automatic renewal. Expires
                  automatically after 30 days regardless of any other active
                  services (does not align with 3/6/12-month 30PC terms). An
                  expiration reminder is sent 7 days prior to the end of the
                  term; continued access requires a new standalone order.
                </li>
              </ul>
            </div>

            <div class="mt-6 pt-4">
              <button
                type="button"
                data-order-trigger="MC"
                class="border-accent text-accent hover:bg-accent hover:text-background w-full cursor-pointer rounded border px-4 py-2 text-center text-sm font-semibold transition-colors"
              >
                Order
              </button>
            </div>
          </div>
        </div>

        <!-- Distribution & Client Responsibility Notice -->
        <div class="border-border rounded-lg border p-4">
          <p class="text-xs leading-relaxed opacity-80">
            This analysis is distributed to a limited number of clients. Keeping
            these parameters private protects execution quality and preserves
            your structural edge around the level. Position sizing and the
            concurrent management of multiple active positions remain strictly
            within the client's responsibility.
          </p>
        </div>

        <!-- Accepted Currencies Block -->
        <div class="border-border flex flex-col items-start justify-between gap-3 rounded-lg border p-4 sm:flex-row sm:items-center">
          <p class="text-xs font-semibold tracking-wider uppercase opacity-80">
            Accepted Currencies
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="border-border rounded border px-3 py-1 text-xs font-medium opacity-90">
              EUR
            </span>
            <span class="border-accent/60 text-accent rounded border px-3 py-1 text-xs font-medium">
              Cryptocurrency (EUR equivalent)
            </span>
          </div>
        </div>
      </section>

      <section>
        <h2 class="mb-3 text-sm font-semibold">Partnerships</h2>
        <ul class="space-y-3 text-sm leading-relaxed">
          <li>
            <span class="font-medium">Research &amp; Media</span>{" "}
            <span class="opacity-80">
              &mdash; Analytical contributions, market mechanics breakdowns, and
              B2B inquiries.
            </span>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="mb-3 text-sm font-semibold">General Inquiries</h2>
        <p class="text-sm leading-relaxed opacity-80">
          For partnerships or questions not covered above:
        </p>
        <p class="mt-2 text-sm">
          <span class="font-semibold">Email:</span>{" "}
          <a
            href={`mailto:${email}`}
            class="text-accent hover:underline"
          >
            {email}
          </a>
        </p>
      </section>

      <section class="border-border border-t pt-6">
        <p class="text-xs leading-relaxed opacity-65">
          All outputs represent general market research and educational analysis
          of market mechanics. Nothing provided constitutes investment advice,
          portfolio management, or solicitation. Paid services are not available
          in sanctioned jurisdictions.
        </p>
      </section>
    </div>

    <!-- Order Builder Modal -->
    <div
      id="order-modal"
      data-access-key={web3formsKey}
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 p-4 backdrop-blur-xs"
      role="dialog"
      aria-modal="true"
      aria-labelledby="order-modal-title"
    >
      <div class="border-border bg-background relative max-h-[92vh] w-full max-w-2xl overflow-y-auto rounded-lg border p-6 shadow-xl sm:p-8">
        <div class="border-border mb-6 flex items-center justify-between border-b pb-4">
          <div>
            <p class="text-accent text-xs font-semibold tracking-wider uppercase">
              Margin of Logic
            </p>
            <h2 id="order-modal-title" class="mt-0.5 text-xl font-semibold">
              Order Request
            </h2>
          </div>
          <button
            type="button"
            id="order-modal-close"
            aria-label="Close modal"
            class="border-border hover:border-accent hover:text-accent cursor-pointer rounded border px-3 py-1 text-base transition-colors"
          >
            &times;
          </button>
        </div>

        <form id="order-form" class="space-y-6">
          <!-- Hidden spam protection -->
          <input
            type="checkbox"
            name="botcheck"
            id="order-botcheck"
            class="hidden"
          />

          <!-- Service Selection -->
          <fieldset class="space-y-3">
            <legend class="mb-2.5 text-xs font-semibold tracking-wider uppercase opacity-75">
              Select Services
            </legend>

            <!-- Single Active Level -->
            <label class="border-border hover:border-accent/60 flex cursor-pointer items-start justify-between gap-4 rounded-md border p-4 transition-colors">
              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  id="svc-sal"
                  data-code="SAL"
                  class="accent-accent mt-1 size-4 cursor-pointer"
                />
                <div>
                  <span class="block text-base font-medium">
                    Single Active Level (SAL)
                  </span>
                  <span class="block text-xs opacity-65">One-time analysis</span>
                </div>
              </div>
              <span class="text-base font-semibold whitespace-nowrap">
                €100 <span class="text-xs font-normal opacity-75">/ one-time</span>
              </span>
            </label>

            <!-- Continuous 30-Pair Coverage -->
            <div class="border-border hover:border-accent/60 rounded-md border p-4 transition-colors">
              <label class="flex cursor-pointer items-start justify-between gap-4">
                <div class="flex items-start gap-3">
                  <input
                    type="checkbox"
                    id="svc-30pc"
                    data-code="30PC"
                    class="accent-accent mt-1 size-4 cursor-pointer"
                  />
                  <div>
                    <span class="block text-base font-medium">
                      Continuous 30-Pair Coverage (30PC)
                    </span>
                    <span class="block text-xs opacity-65">
                      Ongoing 30 FX pairs coverage
                    </span>
                  </div>
                </div>
                <span
                  id="svc-30pc-price"
                  class="text-base font-semibold whitespace-nowrap"
                >
                  €250 <span class="text-xs font-normal opacity-75">/ 3 months</span>
                </span>
              </label>

              <!-- Duration Selector -->
              <div
                id="svc-30pc-durations"
                class="border-border mt-4 hidden grid-cols-3 gap-3 border-t pt-4"
              >
                <label class="border-border has-checked:border-accent has-checked:text-accent flex cursor-pointer flex-col items-center rounded border px-3 py-2 text-center text-sm transition-colors">
                  <input
                    type="radio"
                    name="coverage_duration"
                    value="250"
                    data-label="3 months"
                    checked
                    class="sr-only"
                  />
                  <span class="font-semibold">€250</span>
                  <span class="text-xs opacity-75">3 months</span>
                </label>
                <label class="border-border has-checked:border-accent has-checked:text-accent flex cursor-pointer flex-col items-center rounded border px-3 py-2 text-center text-sm transition-colors">
                  <input
                    type="radio"
                    name="coverage_duration"
                    value="450"
                    data-label="6 months"
                    class="sr-only"
                  />
                  <span class="font-semibold">€450</span>
                  <span class="text-xs opacity-75">6 months</span>
                </label>
                <label class="border-border has-checked:border-accent has-checked:text-accent flex cursor-pointer flex-col items-center rounded border px-3 py-2 text-center text-sm transition-colors">
                  <input
                    type="radio"
                    name="coverage_duration"
                    value="650"
                    data-label="12 months"
                    class="sr-only"
                  />
                  <span class="font-semibold">€650</span>
                  <span class="text-xs opacity-75">12 months</span>
                </label>
              </div>
            </div>

            <!-- Active Level Management -->
            <label class="border-border hover:border-accent/60 flex cursor-pointer items-start justify-between gap-4 rounded-md border p-4 transition-colors">
              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  id="svc-alm"
                  data-code="ALM"
                  class="accent-accent mt-1 size-4 cursor-pointer"
                />
                <div>
                  <span class="block text-base font-medium">
                    Active Level Management &amp; Risk Support (ALM)
                  </span>
                  <span class="block text-xs opacity-65">
                    Optional add-on for SAL or full 30PC term
                  </span>
                </div>
              </div>
              <span class="text-base font-semibold whitespace-nowrap">
                +€50 <span class="text-xs font-normal opacity-75">/ one-time add-on</span>
              </span>
            </label>

            <!-- Monthly Trading Consultation -->
            <label class="border-border hover:border-accent/60 flex cursor-pointer items-start justify-between gap-4 rounded-md border p-4 transition-colors">
              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  id="svc-mc"
                  data-code="MC"
                  class="accent-accent mt-1 size-4 cursor-pointer"
                />
                <div>
                  <span class="block text-base font-medium">
                    Monthly Trading Consultation (MC)
                  </span>
                  <span class="block text-xs opacity-65">
                    Interactive email communication
                  </span>
                </div>
              </div>
              <span class="text-base font-semibold whitespace-nowrap">
                €30 <span class="text-xs font-normal opacity-75">/ 30 days</span>
              </span>
            </label>
          </fieldset>

          <!-- Customer Email -->
          <div>
            <label for="order-email" class="mb-2 block text-sm font-medium">
              Email <span class="text-accent">*</span>
            </label>
            <input
              type="email"
              id="order-email"
              name="email"
              required
              placeholder="you@example.com"
              class="border-border bg-background focus:ring-accent w-full rounded-md border px-3.5 py-2.5 text-base focus:ring-1 focus:outline-none"
            />
          </div>

          <!-- Payment Currency -->
          <fieldset>
            <legend class="mb-2 block text-sm font-medium">
              Payment Currency <span class="text-accent">*</span>
            </legend>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <label class="border-border has-checked:border-accent has-checked:text-accent flex cursor-pointer items-center gap-2.5 rounded-md border px-4 py-3 text-sm transition-colors">
                <input
                  type="radio"
                  name="payment_currency"
                  value="EUR"
                  required
                  class="accent-accent size-4 cursor-pointer"
                />
                <span>EUR</span>
              </label>
              <label class="border-border has-checked:border-accent has-checked:text-accent flex cursor-pointer items-center gap-2.5 rounded-md border px-4 py-3 text-sm transition-colors">
                <input
                  type="radio"
                  name="payment_currency"
                  value="Cryptocurrency (EUR equivalent)"
                  required
                  class="accent-accent size-4 cursor-pointer"
                />
                <span>Cryptocurrency (EUR equivalent)</span>
              </label>
            </div>
          </fieldset>

          <!-- Total & Submit -->
          <div class="border-border border-t pt-5">
            <div class="mb-5 flex items-baseline justify-between">
              <span class="text-sm font-semibold tracking-wider uppercase opacity-75">
                Total
              </span>
              <div class="text-right">
                <span id="order-total" class="text-3xl font-bold">€0</span>
                <p class="mt-0.5 text-xs opacity-65">
                  EUR or Cryptocurrency (EUR equivalent)
                </p>
              </div>
            </div>

            <p id="order-error" class="mb-3 hidden text-sm text-red-400"></p>

            <button
              type="submit"
              id="order-submit-btn"
              class="border-accent text-accent hover:bg-accent hover:text-background w-full cursor-pointer rounded border px-4 py-3 text-base font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-50"
            >
              Submit Order
            </button>
          </div>
        </form>

        <!-- Confirmation State -->
        <div id="order-confirmation" class="hidden space-y-6 py-4">
          <div class="space-y-4">
            <p class="text-accent text-sm font-semibold tracking-wider uppercase">
              Order Received
            </p>

            <div class="border-border rounded-md border px-4 py-3">
              <p class="text-xs tracking-wider uppercase opacity-65">
                Order Reference
              </p>
              <p id="order-ref-display" class="text-accent mt-1 font-mono text-lg font-bold"></p>
            </div>

            <p class="text-sm leading-relaxed opacity-85">
              Thank you for your order. Your request has been logged. Payment
              instructions and onboarding details will be sent to your email
              address within 24 hours.
            </p>

            <!-- Separated Order Summary -->
            <div class="border-border space-y-3 border-y py-4">
              <p class="text-xs font-semibold tracking-wider uppercase opacity-75">
                Order Summary
              </p>
              <div class="space-y-1.5">
                <p class="text-xs font-medium opacity-70">Selected Services:</p>
                <ul
                  id="order-summary-services"
                  class="list-disc space-y-1 pl-5 text-sm leading-relaxed opacity-90"
                ></ul>
              </div>
              <div class="border-border flex items-baseline justify-between border-t pt-3">
                <span class="text-xs font-semibold tracking-wider uppercase opacity-75">
                  Total Amount
                </span>
                <span id="order-summary-total" class="text-lg font-bold"></span>
              </div>
            </div>

            <p class="text-sm leading-relaxed opacity-85">
              Please keep your Order Reference for all payment and email
              correspondence.
            </p>

            <p class="text-sm leading-relaxed opacity-85">
              Best regards,<br />
              Margin of Logic Team
            </p>
          </div>

          <button
            type="button"
            id="order-done-btn"
            class="border-border hover:border-accent hover:text-accent w-full cursor-pointer rounded border px-4 py-3 text-base font-semibold transition-colors"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  function initOrderModal() {
    const modal = document.getElementById("order-modal");
    if (!modal || modal.dataset.initialized === "true") return;
    modal.dataset.initialized = "true";

    const accessKey = modal.dataset.accessKey ?? "";
    const closeBtn = document.getElementById("order-modal-close");
    const doneBtn = document.getElementById("order-done-btn");
    const form = document.getElementById("order-form") as HTMLFormElement | null;
    const confirmation = document.getElementById("order-confirmation");
    const refDisplay = document.getElementById("order-ref-display");
    const summaryServicesEl = document.getElementById("order-summary-services");
    const summaryTotalEl = document.getElementById("order-summary-total");
    const errorEl = document.getElementById("order-error");
    const totalEl = document.getElementById("order-total");
    const submitBtn = document.getElementById(
      "order-submit-btn"
    ) as HTMLButtonElement | null;

    const cbSAL = document.getElementById("svc-sal") as HTMLInputElement | null;
    const cb30PC = document.getElementById("svc-30pc") as HTMLInputElement | null;
    const cbALM = document.getElementById("svc-alm") as HTMLInputElement | null;
    const cbMC = document.getElementById("svc-mc") as HTMLInputElement | null;
    const durationsBox = document.getElementById("svc-30pc-durations");
    const price30PCEl = document.getElementById("svc-30pc-price");
    const emailInput = document.getElementById(
      "order-email"
    ) as HTMLInputElement | null;
    const botcheckInput = document.getElementById(
      "order-botcheck"
    ) as HTMLInputElement | null;

    if (
      !form ||
      !confirmation ||
      !refDisplay ||
      !summaryServicesEl ||
      !summaryTotalEl ||
      !errorEl ||
      !totalEl ||
      !submitBtn ||
      !cbSAL ||
      !cb30PC ||
      !cbALM ||
      !cbMC ||
      !durationsBox ||
      !price30PCEl ||
      !emailInput
    ) {
      return;
    }

    const generateOrderId = () => {
      const now = new Date();
      const yy = String(now.getFullYear()).slice(-2);
      const mm = String(now.getMonth() + 1).padStart(2, "0");
      const dd = String(now.getDate()).padStart(2, "0");
      const rand = String(Math.floor(1000 + Math.random() * 9000));
      return `${yy}${mm}${dd}-${rand}`;
    };

    const getSelectedDuration = () => {
      const checked = form.querySelector<HTMLInputElement>(
        'input[name="coverage_duration"]:checked'
      );
      const price = checked ? Number(checked.value) : 250;
      const label = checked?.dataset.label ?? "3 months";
      return { price, label };
    };

    const updateSummary = () => {
      let total = 0;

      if (cbSAL.checked) total += 100;

      const { price: covPrice, label: covLabel } = getSelectedDuration();
      price30PCEl.innerHTML = `€${covPrice} <span class="text-xs font-normal opacity-75">/ ${covLabel}</span>`;

      if (cb30PC.checked) {
        durationsBox.classList.remove("hidden");
        durationsBox.classList.add("grid");
        total += covPrice;
      } else {
        durationsBox.classList.add("hidden");
        durationsBox.classList.remove("grid");
      }

      if (cbALM.checked) total += 50;
      if (cbMC.checked) total += 30;

      totalEl.textContent = `€${total}`;
      errorEl.classList.add("hidden");
    };

    const openModal = (initialCode: string) => {
      form.reset();
      form.classList.remove("hidden");
      confirmation.classList.add("hidden");
      errorEl.classList.add("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Submit Order";

      cbSAL.checked = initialCode === "SAL";
      cb30PC.checked = initialCode === "30PC";
      cbALM.checked = initialCode === "ALM";
      cbMC.checked = initialCode === "MC";

      updateSummary();

      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
    };

    const closeModal = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
    };

    document
      .querySelectorAll<HTMLButtonElement>("[data-order-trigger]")
      .forEach(btn => {
        btn.addEventListener("click", () => {
          openModal(btn.dataset.orderTrigger ?? "");
        });
      });

    [cbSAL, cb30PC, cbALM, cbMC].forEach(cb => {
      cb.addEventListener("change", updateSummary);
    });

    form
      .querySelectorAll<HTMLInputElement>('input[name="coverage_duration"]')
      .forEach(radio => {
        radio.addEventListener("change", updateSummary);
      });

    closeBtn?.addEventListener("click", closeModal);
    doneBtn?.addEventListener("click", closeModal);

    modal.addEventListener("click", e => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener("keydown", e => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });

    form.addEventListener("submit", async e => {
      e.preventDefault();

      const codes: string[] = [];
      const items: string[] = [];
      let total = 0;

      if (cbSAL.checked) {
        codes.push("SAL");
        items.push("- Single Active Level (SAL) — €100 / one-time");
        total += 100;
      }
      if (cb30PC.checked) {
        const { price, label } = getSelectedDuration();
        codes.push("30PC");
        items.push(`- Continuous 30-Pair Coverage (30PC) — €${price} / ${label}`);
        total += price;
      }
      if (cbALM.checked) {
        codes.push("ALM");
        items.push("- Active Level Management & Risk Support (ALM) — +€50 / one-time add-on");
        total += 50;
      }
      if (cbMC.checked) {
        codes.push("MC");
        items.push("- Monthly Trading Consultation (MC) — €30 / 30 days");
        total += 30;
      }

      if (codes.length === 0) {
        errorEl.textContent = "Please select at least one service.";
        errorEl.classList.remove("hidden");
        return;
      }

      const currencyRadio = form.querySelector<HTMLInputElement>(
        'input[name="payment_currency"]:checked'
      );
      if (!currencyRadio) {
        errorEl.textContent = "Please select a payment currency.";
        errorEl.classList.remove("hidden");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Submitting...";
      errorEl.classList.add("hidden");

      const orderId = generateOrderId();

      const payload = {
        access_key: accessKey,
        subject: `Order #${orderId} | ${codes.join("+")}`,
        from_name: "Margin of Logic Order",
        order_id: orderId,
        email: emailInput.value.trim(),
        services: items.join("\n"),
        total: `€${total}`,
        payment_currency: currencyRadio.value,
        botcheck: botcheckInput?.checked ?? false,
      };

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();
        if (response.ok && result.success) {
          refDisplay.textContent = `#${orderId}`;
          summaryServicesEl.innerHTML = "";
          items.forEach(item => {
            const li = document.createElement("li");
            li.textContent = item.replace(/^- /, "");
            summaryServicesEl.appendChild(li);
          });
          summaryTotalEl.textContent = `€${total}`;
          form.classList.add("hidden");
          confirmation.classList.remove("hidden");
        } else {
          throw new Error("Submission failed");
        }
      } catch {
        errorEl.textContent =
          "Order submission failed. Please try again or contact MarginOfLogic@protonmail.com directly.";
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "Submit Order";
      }
    });
  }

  initOrderModal();
  document.addEventListener("astro:after-swap", initOrderModal);
</script>
