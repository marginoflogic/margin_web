---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";

const email = "MarginOfLogic@protonmail.com";
const web3formsKey = "71b2cd72-5c28-4670-8e08-ac201aaf5fff";
---

<Layout title="Collaboration | Margin of Logic">
  <Header />
  <Main
    pageTitle="Collaboration"
    pageDesc="Analytical research access, consultations, and partnership inquiries."
  >
    <div class="space-y-10">
      <section class="space-y-6">
        <h2 class="text-sm font-semibold">Analytical Services</h2>

        <!-- Row 1: Primary Level Plans -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <!-- Product 1: Single Active Level -->
          <div class="border-border flex flex-col justify-between rounded-lg border p-5">
            <div class="space-y-4">
              <div>
                <p class="text-accent text-xs font-semibold tracking-wider uppercase">
                  One-Time // Single Level
                </p>
                <h3 class="mt-1 text-lg font-semibold">Single Active Level</h3>
              </div>

              <p class="text-sm leading-relaxed opacity-80">
                One-time structural analysis of a single active price level
                based on current market structure and volume flow.
              </p>

              <div class="border-border border-y py-3">
                <p class="text-2xl font-bold">
                  €100 <span class="text-xs font-normal opacity-75">/ one-time</span>
                </p>
                <p class="mt-1 text-xs opacity-65">
                  or Cryptocurrency (EUR equivalent)
                </p>
              </div>

              <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed opacity-85">
                <li>Defined active price level based on current market structure</li>
                <li>Surrounding liquidity zones and volume context</li>
                <li>
                  Defined invalidation point (Stop Loss reference) and target
                  zone (Take Profit reference)
                </li>
                <li>Price level alert notifications</li>
                <li class="opacity-75">
                  Static analytical output only; active level management is
                  available as an add-on
                </li>
              </ul>
            </div>

            <div class="mt-6 pt-4">
              <button
                type="button"
                data-order-trigger="SAL"
                class="border-accent text-accent hover:bg-accent hover:text-background w-full cursor-pointer rounded border px-4 py-2 text-center text-sm font-semibold transition-colors"
              >
                Order
              </button>
            </div>
          </div>

          <!-- Product 2: Continuous 30-Pair Coverage -->
          <div class="border-border flex flex-col justify-between rounded-lg border p-5">
            <div class="space-y-4">
              <div>
                <p class="text-accent text-xs font-semibold tracking-wider uppercase">
                  Subscription // 30 FX Pairs
                </p>
                <h3 class="mt-1 text-lg font-semibold">
                  Continuous 30-Pair Coverage
                </h3>
              </div>

              <p class="text-sm leading-relaxed opacity-80">
                Ongoing structural analysis and active price levels across 30
                monitored FX pairs.
              </p>

              <div class="border-border border-y py-3">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span>
                    <strong class="text-2xl font-bold">€250</strong>{" "}
                    <span class="text-xs font-normal opacity-75">/ 3 months</span>
                  </span>
                  <span class="opacity-40">·</span>
                  <span>
                    <strong class="text-2xl font-bold">€450</strong>{" "}
                    <span class="text-xs font-normal opacity-75">/ 6 months</span>
                  </span>
                  <span class="opacity-40">·</span>
                  <span>
                    <strong class="text-2xl font-bold">€650</strong>{" "}
                    <span class="text-xs font-normal opacity-75">/ 12 months</span>
                  </span>
                </div>
                <p class="mt-1 text-xs opacity-65">
                  or Cryptocurrency (EUR equivalent)
                </p>
              </div>

              <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed opacity-85">
                <li>Continuous coverage of 30 FX pairs across higher timeframes</li>
                <li>
                  Active price levels with surrounding liquidity zones and
                  volume context
                </li>
                <li>
                  Defined invalidation points (Stop Loss references) and target
                  zones (Take Profit references)
                </li>
                <li>Price level alert notifications</li>
                <li class="opacity-75">
                  Static analytical output only; active level management is
                  available as an add-on
                </li>
              </ul>
            </div>

            <div class="mt-6 pt-4">
              <button
                type="button"
                data-order-trigger="30PC"
                class="border-accent text-accent hover:bg-accent hover:text-background w-full cursor-pointer rounded border px-4 py-2 text-center text-sm font-semibold transition-colors"
              >
                Order
              </button>
            </div>
          </div>
        </div>

        <!-- Row 2: Add-on Support & Monthly Consultation -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <!-- Optional Add-on: Active Level Management -->
          <div class="border-accent/50 flex flex-col justify-between rounded-lg border p-5">
            <div class="space-y-4">
              <div>
                <p class="text-accent text-xs font-semibold tracking-wider uppercase">
                  Optional Add-On // For Both Level Plans
                </p>
                <h3 class="mt-1 text-lg font-semibold">
                  Active Level Management &amp; Risk Support
                </h3>
              </div>

              <p class="text-sm leading-relaxed opacity-80">
                Ongoing analytical guidance for your active price levels,
                continuing throughout their entire lifecycle until closure. Flat
                fee covering all active levels within your chosen plan.
              </p>

              <div class="border-border border-y py-3">
                <p class="text-2xl font-bold">
                  + €50 <span class="text-xs font-normal opacity-75">/ selected plan</span>
                </p>
                <p class="mt-1 text-xs opacity-65">
                  or Cryptocurrency (EUR equivalent)
                </p>
              </div>

              <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed opacity-85">
                <li>
                  Continuous monitoring of active price levels based on live
                  market structure and volume flow
                </li>
                <li>
                  Real-time alerts when new volume layers form ahead of the
                  target (signaling potential reversal or early exit zones)
                </li>
                <li>
                  Early warning when adverse volume accumulates against the
                  level, including objective context for risk reduction (e.g.,
                  breakeven considerations)
                </li>
                <li>
                  Surrounding liquidity zones, volume context, defined
                  invalidation point (Stop Loss reference), and target zone
                  (Take Profit reference)
                </li>
                <li>
                  Analytical guidance only; all execution and management
                  decisions remain strictly with the client
                </li>
              </ul>

              <p class="border-border border-t pt-4 text-xs leading-relaxed italic opacity-75">
                Based on published historical statistics, active volume-based risk
                management has improved outcome consistency by up to 30% compared
                to passive level holding.
              </p>
            </div>

            <div class="mt-6 pt-4">
              <button
                type="button"
                data-order-trigger="ALM"
                class="border-accent text-accent hover:bg-accent hover:text-background w-full cursor-pointer rounded border px-4 py-2 text-center text-sm font-semibold transition-colors"
              >
                Order
              </button>
            </div>
          </div>

          <!-- Product 3: Monthly Trading Consultation -->
          <div class="border-border flex flex-col justify-between rounded-lg border p-5">
            <div class="space-y-4">
              <div>
                <p class="text-accent text-xs font-semibold tracking-wider uppercase">
                  Monthly // Email Access
                </p>
                <h3 class="mt-1 text-lg font-semibold">
                  Monthly Trading Consultation
                </h3>
              </div>

              <p class="text-sm leading-relaxed opacity-80">
                Direct email access for questions on any trading-related topic,
                backed by 12 years of live market experience.
              </p>

              <div class="border-border border-y py-3">
                <p class="text-2xl font-bold">
                  €30 <span class="text-xs font-normal opacity-75">/ month</span>
                </p>
                <p class="mt-1 text-xs opacity-65">
                  or Cryptocurrency (EUR equivalent)
                </p>
              </div>

              <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed opacity-85">
                <li>
                  Direct email inquiries on any trading topic (market structure,
                  volume mechanics, or workflow)
                </li>
                <li>Structured, written responses delivered via email</li>
                <li>Practical context based on 12 years of market experience</li>
                <li>
                  Strictly educational and analytical scope (not investment
                  advice or active level management)
                </li>
              </ul>
            </div>

            <div class="mt-6 pt-4">
              <button
                type="button"
                data-order-trigger="MC"
                class="border-accent text-accent hover:bg-accent hover:text-background w-full cursor-pointer rounded border px-4 py-2 text-center text-sm font-semibold transition-colors"
              >
                Order
              </button>
            </div>
          </div>
        </div>

        <!-- Accepted Currencies Block -->
        <div class="border-border flex flex-col items-start justify-between gap-3 rounded-lg border p-4 sm:flex-row sm:items-center">
          <p class="text-xs font-semibold tracking-wider uppercase opacity-80">
            Accepted Currencies
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="border-border rounded border px-3 py-1 text-xs font-medium opacity-90">
              EUR
            </span>
            <span class="border-accent/60 text-accent rounded border px-3 py-1 text-xs font-medium">
              Cryptocurrency (EUR equivalent)
            </span>
          </div>
        </div>
      </section>

      <section>
        <h2 class="mb-3 text-sm font-semibold">Partnerships</h2>
        <ul class="space-y-3 text-sm leading-relaxed">
          <li>
            <span class="font-medium">Research &amp; Media</span>{" "}
            <span class="opacity-80">
              &mdash; Analytical contributions, market mechanics breakdowns, and
              B2B inquiries.
            </span>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="mb-3 text-sm font-semibold">General Inquiries</h2>
        <p class="text-sm leading-relaxed opacity-80">
          For partnerships or questions not covered above:
        </p>
        <p class="mt-2 text-sm">
          <span class="font-semibold">Email:</span>{" "}
          <a
            href={`mailto:${email}`}
            class="text-accent hover:underline"
          >
            {email}
          </a>
        </p>
      </section>

      <section class="border-border border-t pt-6">
        <p class="text-xs leading-relaxed opacity-65">
          All outputs represent general market research and educational analysis
          of market mechanics. Nothing provided constitutes investment advice,
          portfolio management, or solicitation. Paid services are not available
          in sanctioned jurisdictions.
        </p>
      </section>
    </div>

    <!-- Order Builder Modal -->
    <div
      id="order-modal"
      data-access-key={web3formsKey}
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 p-4 backdrop-blur-xs"
      role="dialog"
      aria-modal="true"
      aria-labelledby="order-modal-title"
    >
      <div class="border-border bg-background relative max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-lg border p-6 shadow-xl">
        <div class="border-border mb-5 flex items-center justify-between border-b pb-3">
          <div>
            <p class="text-accent text-xs font-semibold tracking-wider uppercase">
              Margin of Logic
            </p>
            <h2 id="order-modal-title" class="text-lg font-semibold">
              Order Request
            </h2>
          </div>
          <button
            type="button"
            id="order-modal-close"
            aria-label="Close modal"
            class="border-border hover:border-accent hover:text-accent cursor-pointer rounded border px-2.5 py-1 text-sm transition-colors"
          >
            &times;
          </button>
        </div>

        <form id="order-form" class="space-y-5">
          <!-- Hidden spam protection -->
          <input
            type="checkbox"
            name="botcheck"
            id="order-botcheck"
            class="hidden"
          />

          <!-- Service Selection -->
          <fieldset class="space-y-2.5">
            <legend class="mb-2 text-xs font-semibold tracking-wider uppercase opacity-75">
              Select Services
            </legend>

            <!-- Single Active Level -->
            <label class="border-border hover:border-accent/60 flex cursor-pointer items-start justify-between gap-3 rounded-md border p-3 transition-colors">
              <div class="flex items-start gap-2.5">
                <input
                  type="checkbox"
                  id="svc-sal"
                  data-code="SAL"
                  class="accent-accent mt-1 cursor-pointer"
                />
                <div>
                  <span class="block text-sm font-medium">Single Active Level</span>
                  <span class="block text-xs opacity-65">One-time analysis</span>
                </div>
              </div>
              <span class="text-sm font-semibold whitespace-nowrap">
                €100 <span class="text-xs font-normal opacity-75">/ one-time</span>
              </span>
            </label>

            <!-- Continuous 30-Pair Coverage -->
            <div class="border-border hover:border-accent/60 rounded-md border p-3 transition-colors">
              <label class="flex cursor-pointer items-start justify-between gap-3">
                <div class="flex items-start gap-2.5">
                  <input
                    type="checkbox"
                    id="svc-30pc"
                    data-code="30PC"
                    class="accent-accent mt-1 cursor-pointer"
                  />
                  <div>
                    <span class="block text-sm font-medium">
                      Continuous 30-Pair Coverage
                    </span>
                    <span class="block text-xs opacity-65">
                      Ongoing 30 FX pairs subscription
                    </span>
                  </div>
                </div>
                <span
                  id="svc-30pc-price"
                  class="text-sm font-semibold whitespace-nowrap"
                >
                  €250 <span class="text-xs font-normal opacity-75">/ 3 months</span>
                </span>
              </label>

              <!-- Duration Selector -->
              <div
                id="svc-30pc-durations"
                class="border-border mt-3 hidden grid-cols-3 gap-2 border-t pt-3"
              >
                <label class="border-border has-checked:border-accent has-checked:text-accent flex cursor-pointer flex-col items-center rounded border px-2 py-1.5 text-center text-xs transition-colors">
                  <input
                    type="radio"
                    name="coverage_duration"
                    value="250"
                    data-label="3 months"
                    checked
                    class="sr-only"
                  />
                  <span class="font-semibold">€250</span>
                  <span class="opacity-75">3 months</span>
                </label>
                <label class="border-border has-checked:border-accent has-checked:text-accent flex cursor-pointer flex-col items-center rounded border px-2 py-1.5 text-center text-xs transition-colors">
                  <input
                    type="radio"
                    name="coverage_duration"
                    value="450"
                    data-label="6 months"
                    class="sr-only"
                  />
                  <span class="font-semibold">€450</span>
                  <span class="opacity-75">6 months</span>
                </label>
                <label class="border-border has-checked:border-accent has-checked:text-accent flex cursor-pointer flex-col items-center rounded border px-2 py-1.5 text-center text-xs transition-colors">
                  <input
                    type="radio"
                    name="coverage_duration"
                    value="650"
                    data-label="12 months"
                    class="sr-only"
                  />
                  <span class="font-semibold">€650</span>
                  <span class="opacity-75">12 months</span>
                </label>
              </div>
            </div>

            <!-- Active Level Management -->
            <label class="border-border hover:border-accent/60 flex cursor-pointer items-start justify-between gap-3 rounded-md border p-3 transition-colors">
              <div class="flex items-start gap-2.5">
                <input
                  type="checkbox"
                  id="svc-alm"
                  data-code="ALM"
                  class="accent-accent mt-1 cursor-pointer"
                />
                <div>
                  <span class="block text-sm font-medium">
                    Active Level Management &amp; Risk Support
                  </span>
                  <span class="block text-xs opacity-65">
                    Optional add-on for level plans
                  </span>
                </div>
              </div>
              <span class="text-sm font-semibold whitespace-nowrap">
                +€50 <span class="text-xs font-normal opacity-75">/ selected plan</span>
              </span>
            </label>

            <!-- Monthly Trading Consultation -->
            <label class="border-border hover:border-accent/60 flex cursor-pointer items-start justify-between gap-3 rounded-md border p-3 transition-colors">
              <div class="flex items-start gap-2.5">
                <input
                  type="checkbox"
                  id="svc-mc"
                  data-code="MC"
                  class="accent-accent mt-1 cursor-pointer"
                />
                <div>
                  <span class="block text-sm font-medium">
                    Monthly Trading Consultation
                  </span>
                  <span class="block text-xs opacity-65">
                    Direct email access
                  </span>
                </div>
              </div>
              <span class="text-sm font-semibold whitespace-nowrap">
                €30 <span class="text-xs font-normal opacity-75">/ month</span>
              </span>
            </label>
          </fieldset>

          <!-- Customer Email -->
          <div>
            <label for="order-email" class="mb-1.5 block text-sm font-medium">
              Email <span class="text-accent">*</span>
            </label>
            <input
              type="email"
              id="order-email"
              name="email"
              required
              placeholder="you@example.com"
              class="border-border bg-background focus:ring-accent w-full rounded-md border px-3 py-2 text-sm focus:ring-1 focus:outline-none"
            />
          </div>

          <!-- Payment Currency -->
          <fieldset>
            <legend class="mb-1.5 block text-sm font-medium">
              Payment Currency <span class="text-accent">*</span>
            </legend>
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              <label class="border-border has-checked:border-accent has-checked:text-accent flex cursor-pointer items-center gap-2 rounded-md border px-3 py-2 text-sm transition-colors">
                <input
                  type="radio"
                  name="payment_currency"
                  value="EUR"
                  required
                  class="accent-accent cursor-pointer"
                />
                <span>EUR</span>
              </label>
              <label class="border-border has-checked:border-accent has-checked:text-accent flex cursor-pointer items-center gap-2 rounded-md border px-3 py-2 text-sm transition-colors">
                <input
                  type="radio"
                  name="payment_currency"
                  value="Cryptocurrency (EUR equivalent)"
                  required
                  class="accent-accent cursor-pointer"
                />
                <span>Cryptocurrency (EUR eq.)</span>
              </label>
            </div>
          </fieldset>

          <!-- Total & Submit -->
          <div class="border-border border-t pt-4">
            <div class="mb-4 flex items-baseline justify-between">
              <span class="text-xs font-semibold tracking-wider uppercase opacity-75">
                Total
              </span>
              <div class="text-right">
                <span id="order-total" class="text-2xl font-bold">€0</span>
                <p class="text-xs opacity-65">
                  EUR or Cryptocurrency (EUR equivalent)
                </p>
              </div>
            </div>

            <p id="order-error" class="mb-3 hidden text-xs text-red-400"></p>

            <button
              type="submit"
              id="order-submit-btn"
              class="border-accent text-accent hover:bg-accent hover:text-background w-full cursor-pointer rounded border px-4 py-2.5 text-sm font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-50"
            >
              Submit Order
            </button>
          </div>
        </form>

        <!-- Confirmation State -->
        <div id="order-confirmation" class="hidden space-y-4 py-4">
          <p class="text-accent text-xs font-semibold tracking-wider uppercase">
            Order Received
          </p>
          <p class="text-sm leading-relaxed opacity-85">
            Your order request has been submitted. Payment details and next
            steps will be sent to your email address shortly.
          </p>
          <button
            type="button"
            id="order-done-btn"
            class="border-border hover:border-accent hover:text-accent w-full cursor-pointer rounded border px-4 py-2 text-sm font-semibold transition-colors"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  function initOrderModal() {
    const modal = document.getElementById("order-modal");
    if (!modal || modal.dataset.initialized === "true") return;
    modal.dataset.initialized = "true";

    const accessKey = modal.dataset.accessKey ?? "";
    const closeBtn = document.getElementById("order-modal-close");
    const doneBtn = document.getElementById("order-done-btn");
    const form = document.getElementById("order-form") as HTMLFormElement | null;
    const confirmation = document.getElementById("order-confirmation");
    const errorEl = document.getElementById("order-error");
    const totalEl = document.getElementById("order-total");
    const submitBtn = document.getElementById(
      "order-submit-btn"
    ) as HTMLButtonElement | null;

    const cbSAL = document.getElementById("svc-sal") as HTMLInputElement | null;
    const cb30PC = document.getElementById("svc-30pc") as HTMLInputElement | null;
    const cbALM = document.getElementById("svc-alm") as HTMLInputElement | null;
    const cbMC = document.getElementById("svc-mc") as HTMLInputElement | null;
    const durationsBox = document.getElementById("svc-30pc-durations");
    const price30PCEl = document.getElementById("svc-30pc-price");
    const emailInput = document.getElementById(
      "order-email"
    ) as HTMLInputElement | null;
    const botcheckInput = document.getElementById(
      "order-botcheck"
    ) as HTMLInputElement | null;

    if (
      !form ||
      !confirmation ||
      !errorEl ||
      !totalEl ||
      !submitBtn ||
      !cbSAL ||
      !cb30PC ||
      !cbALM ||
      !cbMC ||
      !durationsBox ||
      !price30PCEl ||
      !emailInput
    ) {
      return;
    }

    const getSelectedDuration = () => {
      const checked = form.querySelector<HTMLInputElement>(
        'input[name="coverage_duration"]:checked'
      );
      const price = checked ? Number(checked.value) : 250;
      const label = checked?.dataset.label ?? "3 months";
      return { price, label };
    };

    const updateSummary = () => {
      let total = 0;

      if (cbSAL.checked) total += 100;

      const { price: covPrice, label: covLabel } = getSelectedDuration();
      price30PCEl.innerHTML = `€${covPrice} <span class="text-xs font-normal opacity-75">/ ${covLabel}</span>`;

      if (cb30PC.checked) {
        durationsBox.classList.remove("hidden");
        durationsBox.classList.add("grid");
        total += covPrice;
      } else {
        durationsBox.classList.add("hidden");
        durationsBox.classList.remove("grid");
      }

      if (cbALM.checked) total += 50;
      if (cbMC.checked) total += 30;

      totalEl.textContent = `€${total}`;
      errorEl.classList.add("hidden");
    };

    const openModal = (initialCode: string) => {
      form.reset();
      form.classList.remove("hidden");
      confirmation.classList.add("hidden");
      errorEl.classList.add("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Submit Order";

      cbSAL.checked = initialCode === "SAL";
      cb30PC.checked = initialCode === "30PC";
      cbALM.checked = initialCode === "ALM";
      cbMC.checked = initialCode === "MC";

      updateSummary();

      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
    };

    const closeModal = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
    };

    document
      .querySelectorAll<HTMLButtonElement>("[data-order-trigger]")
      .forEach(btn => {
        btn.addEventListener("click", () => {
          openModal(btn.dataset.orderTrigger ?? "");
        });
      });

    [cbSAL, cb30PC, cbALM, cbMC].forEach(cb => {
      cb.addEventListener("change", updateSummary);
    });

    form
      .querySelectorAll<HTMLInputElement>('input[name="coverage_duration"]')
      .forEach(radio => {
        radio.addEventListener("change", updateSummary);
      });

    closeBtn?.addEventListener("click", closeModal);
    doneBtn?.addEventListener("click", closeModal);

    modal.addEventListener("click", e => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener("keydown", e => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });

    form.addEventListener("submit", async e => {
      e.preventDefault();

      const codes: string[] = [];
      const items: string[] = [];
      let total = 0;

      if (cbSAL.checked) {
        codes.push("SAL");
        items.push("Single Active Level (€100 / one-time)");
        total += 100;
      }
      if (cb30PC.checked) {
        const { price, label } = getSelectedDuration();
        codes.push("30PC");
        items.push(`Continuous 30-Pair Coverage (€${price} / ${label})`);
        total += price;
      }
      if (cbALM.checked) {
        codes.push("ALM");
        items.push("Active Level Management & Risk Support (+€50 / selected plan)");
        total += 50;
      }
      if (cbMC.checked) {
        codes.push("MC");
        items.push("Monthly Trading Consultation (€30 / month)");
        total += 30;
      }

      if (codes.length === 0) {
        errorEl.textContent = "Please select at least one service.";
        errorEl.classList.remove("hidden");
        return;
      }

      const currencyRadio = form.querySelector<HTMLInputElement>(
        'input[name="payment_currency"]:checked'
      );
      if (!currencyRadio) {
        errorEl.textContent = "Please select a payment currency.";
        errorEl.classList.remove("hidden");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Submitting...";
      errorEl.classList.add("hidden");

      const payload = {
        access_key: accessKey,
        subject: `Order_${codes.join("+")}`,
        from_name: "Margin of Logic Order",
        email: emailInput.value.trim(),
        services: items.join(" | "),
        total: `€${total}`,
        payment_currency: currencyRadio.value,
        botcheck: botcheckInput?.checked ?? false,
      };

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();
        if (response.ok && result.success) {
          form.classList.add("hidden");
          confirmation.classList.remove("hidden");
        } else {
          throw new Error("Submission failed");
        }
      } catch {
        errorEl.textContent =
          "Order submission failed. Please try again or contact MarginOfLogic@protonmail.com directly.";
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "Submit Order";
      }
    });
  }

  initOrderModal();
  document.addEventListener("astro:after-swap", initOrderModal);
</script>
