---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { igPosts } from "@/data/igPosts";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const latestIgPosts = igPosts.slice(0, 3);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b py-4">
      <p>
        Mapping technical trade ideas and education on how markets really work
      </p>
    </section>

    <div class="grid grid-cols-1 gap-10 py-8 lg:grid-cols-3">
      <!-- Ľavý stĺpec: Články a mesačné vyhodnotenia (2/3 šírky) -->
      <div class="lg:col-span-2">
        {
          featuredPosts.length > 0 && (
            <section
              id="featured"
              class:list={[
                "pb-6",
                { "border-border border-b": recentPosts.length > 0 },
              ]}
            >
              <h2 class="text-2xl font-semibold tracking-wide">
                {t.home.featured}
              </h2>
              <ul>
                {featuredPosts.map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </section>
          )
        }

        {
          recentPosts.length > 0 && (
            <section id="recent-posts" class="pt-8 pb-6">
              <h2 class="text-2xl font-semibold tracking-wide">
                {t.home.recentPosts}
              </h2>
              <ul>
                {recentPosts.slice(0, postsConfig.perIndex).map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </section>
          )
        }

        <div class="my-8 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      </div>

    <!-- Pravý stĺpec: Instagram Reels feed (1/3 šírky) -->
      <aside class="border-border border-t pt-8 lg:border-t-0 lg:border-s lg:ps-8 lg:pt-0">
        <h2 class="mb-6 text-2xl font-semibold tracking-wide">
          Instagram Reels
        </h2>
        <div class="flex flex-col gap-5">
          {
            latestIgPosts.map(post => (
              <article class="border-border flex items-start gap-4 border-b pb-5 last:border-b-0">
                <a
                  href={post.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Watch on Instagram"
                  class="group relative w-40 shrink-0 overflow-hidden rounded-md border border-border"
                >
                  <img
                    src={post.image}
                    alt="Instagram Reel Hook Slide"
                    class="aspect-[9/16] w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                  <span class="absolute top-2 right-2 rounded bg-black/70 px-1.5 py-0.5 text-[10px] font-medium tracking-wider text-white backdrop-blur-xs">
                    ▶ IG
                  </span>
                </a>
                <div class="min-w-0 flex-1">
                  <p class="text-xs opacity-60">{post.date}</p>
                  <p class="mt-1 text-sm leading-relaxed">{post.preview}</p>
                  {post.moreText && (
                    <details class="group mt-1 text-sm">
                      <summary class="text-accent cursor-pointer list-none font-medium hover:underline">
                        <span class="group-open:hidden">more</span>
                        <span class="hidden group-open:inline">less</span>
                      </summary>
                      <p class="mt-2 whitespace-pre-line leading-relaxed opacity-90">
                        {post.moreText}
                      </p>
                    </details>
                  )}
                </div>
              </article>
            ))
          }
        </div>
        <div class="mt-6 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "reels")}>
            More Reels
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
