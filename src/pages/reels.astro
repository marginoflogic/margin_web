---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import { igPosts } from "@/data/igPosts";
---

<Layout title="Instagram Reels | Margin of Logic">
  <Header />
  <Main
    pageTitle="Instagram Reels"
    pageDesc="Chronological archive of short educational market videos."
  >
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      {
        igPosts.map(post => (
          <article class="border-border flex items-start gap-4 border-b pb-6">
            <a
              href={post.url}
              target="_blank"
              rel="noopener noreferrer"
              title="Watch on Instagram"
              class="group relative w-40 shrink-0 overflow-hidden rounded-md border border-border"
            >
              <img
                src={post.image}
                alt="Instagram Reel Hook Slide"
                loading="lazy"
                class="aspect-[9/16] w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              <div class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/15 transition-colors duration-300 group-hover:bg-black/30">
                <div class="flex size-12 items-center justify-center rounded-full bg-black/65 text-white shadow-lg backdrop-blur-xs transition-transform duration-300 group-hover:scale-110">
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="ms-0.5 size-6"
                    aria-hidden="true"
                  >
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </div>
            </a>
            <div class="min-w-0 flex-1">
              <p class="text-xs opacity-60">{post.date}</p>
              <p class="mt-1 text-sm leading-relaxed">{post.preview}</p>
              {post.moreText && (
                <details class="group mt-1 text-sm">
                  <summary class="text-accent cursor-pointer list-none font-medium hover:underline">
                    <span class="group-open:hidden">more</span>
                    <span class="hidden group-open:inline">less</span>
                  </summary>
                  <p class="mt-2 whitespace-pre-line leading-relaxed opacity-90">
                    {post.moreText}
                  </p>
                </details>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
