---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import { igPosts } from "@/data/igPosts";
---

<Layout title="Instagram Reels | Margin of Logic">
  <Header />
  <Main
    pageTitle="Instagram Reels"
    pageDesc="Chronological archive of short educational market videos."
  >
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        igPosts.map(post => (
          <article class="border-border flex flex-col border-b pb-5">
            <a
              href={post.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block overflow-hidden rounded-md border border-border"
            >
              <img
                src={post.image}
                alt="Instagram Reel Hook Slide"
                class="aspect-[9/16] w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </a>
            <p class="mt-3 text-xs opacity-60">{post.date}</p>
            <p class="mt-1 text-sm leading-relaxed">{post.preview}</p>
            {post.moreText && (
              <details class="mt-1 text-sm">
                <summary class="text-accent cursor-pointer list-none font-medium hover:underline">
                  more
                </summary>
                <p class="mt-2 leading-relaxed opacity-90">{post.moreText}</p>
              </details>
            )}
          </article>
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
