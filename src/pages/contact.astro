---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";

const channels = [
  {
    name: "Instagram",
    handle: "@margin_of_logic",
    url: "https://www.instagram.com/margin_of_logic",
    note: "Short-form reels and visual market frameworks",
  },
  {
    name: "Facebook",
    handle: "Margin of Logic",
    url: "https://www.facebook.com/profile.php?id=61595864072660",
    note: "Posts and educational updates",
  },
  {
    name: "YouTube",
    handle: "@MarginofLogic",
    url: "https://www.youtube.com/@MarginofLogic",
    note: "Long-form market mechanics breakdowns",
  },
  {
    name: "Bluesky",
    handle: "@marginoflogic.bsky.social",
    url: "https://bsky.app/profile/marginoflogic.bsky.social",
    note: "Market structure notes and updates",
  },
  {
    name: "LinkedIn",
    handle: "Margin of Logic",
    url: "https://www.linkedin.com/company/145359630/",
    note: "Analytical and market structure posts",
  },
];
---

<Layout title="Contact | Margin of Logic">
  <Header />
  <Main
    pageTitle="Contact"
    pageDesc="Direct contact details and official channels."
  >
    <div class="max-w-2xl space-y-8">
      <section class="border-border rounded-md border p-5">
        <h2 class="text-base font-semibold">Direct Email</h2>
        <p class="mt-1.5 text-sm leading-relaxed opacity-80">
          For general administrative inquiries or direct communication:
        </p>
        <a
          href="mailto:MarginOfLogic@protonmail.com"
          class="text-accent mt-2 inline-block text-sm font-medium hover:underline"
        >
          MarginOfLogic@protonmail.com
        </a>
      </section>

      <section>
        <h2 class="mb-3 text-base font-semibold">Official Channels</h2>
        <ul class="divide-border border-border divide-y rounded-md border">
          {
            channels.map(channel => (
              <li class="flex flex-col gap-1 p-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <span class="text-sm font-medium">{channel.name}</span>
                  <p class="text-xs opacity-70">{channel.note}</p>
                </div>
                <a
                  href={channel.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent text-sm hover:underline"
                >
                  {channel.handle} &rarr;
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-xs leading-relaxed opacity-70">
          Verification notice: The links listed above are the only official
          Margin of Logic accounts. Margin of Logic does not offer paid signals,
          account management, or unsolicited DMs.
        </p>
      </section>

      <section class="border-border rounded-md border p-5">
        <h2 class="text-base font-semibold">Specific Requests</h2>
        <ul class="mt-2 space-y-2 text-sm opacity-85">
          <li>
            Market mechanics questions &amp; topic suggestions:{" "}
            <a href="/qa" class="text-accent hover:underline">
              Submit via Q&amp;A &rarr;
            </a>
          </li>
          <li>
            Partnerships, media &amp; business inquiries:{" "}
            <a href="/collaboration" class="text-accent hover:underline">
              View Collaboration &rarr;
            </a>
          </li>
        </ul>
      </section>
    </div>
  </Main>
  <Footer />
</Layout>
