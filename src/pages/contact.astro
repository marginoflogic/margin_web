---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
---

<Layout title="Contact | Margin of Logic">
  <Header />
  <Main
    pageTitle="Contact"
    pageDesc="Contact details and official channels."
  >
    <div class="max-w-2xl space-y-10">
      <section>
        <p class="text-sm">
          <span class="font-semibold">Email:</span>{" "}
          <a
            href="mailto:MarginOfLogic@protonmail.com"
            class="text-accent hover:underline"
          >
            MarginOfLogic@protonmail.com
          </a>
        </p>
      </section>

      <section>
        <h2 class="mb-4 text-sm font-semibold">Official Channels</h2>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
          <a
            href="https://www.instagram.com/margin_of_logic"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent inline-flex items-center gap-2 transition-colors"
          >
            <svg
              class="size-5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="4" y="4" width="16" height="16" rx="4"></rect>
              <circle cx="12" cy="12" r="3"></circle>
              <line x1="16.5" y1="7.5" x2="16.5" y2="7.501"></line>
            </svg>
            <span>Instagram</span>
          </a>

          <a
            href="https://www.facebook.com/profile.php?id=61595864072660"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent inline-flex items-center gap-2 transition-colors"
          >
            <svg
              class="size-5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
              ></path>
            </svg>
            <span>Facebook</span>
          </a>

          <a
            href="https://www.youtube.com/@MarginofLogic"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent inline-flex items-center gap-2 transition-colors"
          >
            <svg
              class="size-5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="4"></rect>
              <path d="M10 9l5 3l-5 3z"></path>
            </svg>
            <span>YouTube</span>
          </a>

          <a
            href="https://bsky.app/profile/marginoflogic.bsky.social"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent inline-flex items-center gap-2 transition-colors"
          >
            <svg
              class="size-5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M6.335 5.144c-1.654 -1.199 -4.335 -2.127 -4.335 .826c0 .59 .35 4.953 .556 5.661c.713 2.463 3.13 2.75 5.444 2.369c-4.045 .665 -4.889 3.208 -2.667 5.41c1.03 1.018 1.913 1.59 2.667 1.59c2 0 3.134 -2.769 3.5 -3.5c.333 -.667 .5 -1.167 .5 -1.5c0 .333 .167 .833 .5 1.5c.366 .731 1.5 3.5 3.5 3.5c.754 0 1.637 -.571 2.667 -1.59c2.222 -2.203 1.378 -4.746 -2.667 -5.41c2.314 .38 4.73 .094 5.444 -2.369c.206 -.708 .556 -5.072 .556 -5.661c0 -2.953 -2.68 -2.025 -4.335 -.826c-2.293 1.662 -4.76 5.048 -5.665 6.856c-.905 -1.808 -3.372 -5.194 -5.665 -6.856z"
              ></path>
            </svg>
            <span>Bluesky</span>
          </a>

          <a
            href="https://www.linkedin.com/company/145359630/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent inline-flex items-center gap-2 transition-colors"
          >
            <svg
              class="size-5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="4" y="4" width="16" height="16" rx="2"></rect>
              <line x1="8" y1="11" x2="8" y2="16"></line>
              <line x1="8" y1="8" x2="8" y2="8.01"></line>
              <line x1="12" y1="16" x2="12" y2="11"></line>
              <path d="M16 16v-3a2 2 0 0 0 -4 0"></path>
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>

        <p class="mt-4 text-xs opacity-65">
         
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-sm font-semibold">Specific Requests</h2>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/qa" class="text-accent font-medium hover:underline"
              >Q&amp;A</a
            >
            <span class="opacity-80">
              &mdash; Market mechanics questions and topic suggestions.
            </span>
          </li>
          <li>
            <a
              href="/collaboration"
              class="text-accent font-medium hover:underline"
              >Collaboration</a
            >
            <span class="opacity-80">
              &mdash; Partnerships, media, and business inquiries.
            </span>
          </li>
        </ul>
      </section>
    </div>
  </Main>
  <Footer />
</Layout>
