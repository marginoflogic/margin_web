---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
---

<Layout title="Contact | Margin of Logic">
  <Header />
  <Main
    pageTitle="Contact"
    pageDesc="Direct communication and general inquiries."
  >
    <div class="max-w-2xl">
      <p class="mb-6 text-sm leading-relaxed opacity-80">
        For questions on market mechanics or content topics, use the{" "}
        <a href="/qa" class="text-accent hover:underline">Q&A form</a>. For
        business proposals, see{" "}
        <a href="/collaboration" class="text-accent hover:underline"
          >Collaboration</a
        >.
      </p>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="flex flex-col gap-5"
      >
        <input
          type="hidden"
          name="access_key"
          value="71b2cd72-5c28-4670-8e08-ac201aaf5fff"
        />
        <input
          type="hidden"
          name="subject"
          value="Contact Inquiry – Margin of Logic"
        />
        <input
          type="hidden"
          name="from_name"
          value="Margin of Logic – Contact"
        />
        <!-- Skryté pole proti spam botom -->
        <input type="checkbox" name="botcheck" class="hidden" />

        <div>
          <label for="name" class="mb-1.5 block text-sm font-medium">
            Name <span class="text-accent">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="Your name"
            class="border-border bg-background w-full rounded-md border px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-accent"
          />
        </div>

        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium">
            Email <span class="text-accent">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="you@example.com"
            class="border-border bg-background w-full rounded-md border px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-accent"
          />
        </div>

        <div>
          <label for="topic" class="mb-1.5 block text-sm font-medium">
            Subject <span class="text-accent">*</span>
          </label>
          <input
            type="text"
            id="topic"
            name="topic"
            required
            placeholder="Brief subject of your message"
            class="border-border bg-background w-full rounded-md border px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-accent"
          />
        </div>

        <div>
          <label for="message" class="mb-1.5 block text-sm font-medium">
            Message <span class="text-accent">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder="Write your message..."
            class="border-border bg-background w-full rounded-md border px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-accent"
          ></textarea>
        </div>

        <div>
          <button
            type="submit"
            class="border-accent text-accent hover:bg-accent hover:text-background cursor-pointer rounded-md border px-5 py-2 text-sm font-medium transition-colors"
          >
            Send Message
          </button>
        </div>
      </form>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  window.addEventListener("pageshow", () => {
    const form = document.querySelector("form");
    if (form) form.reset();
  });
</script>
