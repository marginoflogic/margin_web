---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}
---

<div class="border-border my-8 rounded-md border p-5">
  <h3 class="text-base font-semibold">Questions or feedback?</h3>
  <p class="mt-1.5 text-sm leading-relaxed opacity-80">
    If you have a question about the market mechanics covered in this post or
    want to suggest a related topic, submit it directly via the Q&A form.
  </p>
  <a
    href="/qa"
    class="text-accent mt-3 inline-block text-sm font-medium hover:underline"
  >
    Submit a question via Q&A &rarr;
  </a>
</div>
